{
  "name": "notify-paul",
  "version": "0.1.0",
  "private": true,
  "author": "Paul Köpke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulkoepke/notify-paul.git"
  },
  "description": "Local Windows notification service that lets AI agents and scripts reach you via Telegram, email, Discord or ntfy",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test:native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "send-test": "tsx src/send-test.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
